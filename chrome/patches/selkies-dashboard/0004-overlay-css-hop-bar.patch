diff --git a/src/styles/Overlay.css b/src/styles/Overlay.css
--- a/src/styles/Overlay.css
+++ b/src/styles/Overlay.css
@@ -1740,3 +1740,47 @@
     border-color: var(--accent);
 }
 
+
+
+/* Jolee hop session bar (original addition) */
+.jolee-hop-bar {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 1020;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  align-items: end;
+  padding: 0.45rem 0.7rem;
+  background: var(--surface, #181d26);
+  border-bottom: 1px solid var(--border-soft, #2b3441);
+  color: var(--text, #e6ebf3);
+  font-family: system-ui, sans-serif;
+  font-size: 12px;
+  pointer-events: auto;
+}
+.jolee-hop-bar label {
+  display: flex;
+  flex-direction: column;
+  gap: 0.15rem;
+  color: var(--text-muted, #aeb9c9);
+}
+.jolee-hop-bar input {
+  background: var(--input-bg, #12161d);
+  color: var(--input-text, #e6ebf3);
+  border: 1px solid var(--input-border, #6e7b94);
+  padding: 0.3rem 0.4rem;
+  min-width: 10rem;
+}
+.jolee-hop-bar button {
+  padding: 0.35rem 0.7rem;
+  cursor: pointer;
+}
+.jolee-hop-status {
+  font-size: 0.85rem;
+  padding: 0.2rem 0.6rem;
+  border-radius: 999px;
+  background: var(--surface-alt, #1f2530);
+}
